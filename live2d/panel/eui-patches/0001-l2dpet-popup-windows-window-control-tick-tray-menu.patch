+static void eui_dm_entry_props(GVariantBuilder* props, int index) {
+    const eui_tray_entry* e = &g_items[index];
+    if (e->separator) {
+        g_variant_builder_add(props, "{sv}", "type", g_variant_new_string("separator"));
+        return;
+    }
+    g_variant_builder_add(props, "{sv}", "label", g_variant_new_string(e->label != NULL ? e->label : ""));
+    if (!e->enabled) g_variant_builder_add(props, "{sv}", "enabled", g_variant_new_boolean(FALSE));
+    if (e->checked || e->radio || e->checkable) {
+        g_variant_builder_add(props, "{sv}", "toggle-type", g_variant_new_string(e->radio ? "radio" : "checkmark"));
+        g_variant_builder_add(props, "{sv}", "toggle-state", g_variant_new_int32(e->checked ? 1 : 0));
+    }
+    if (eui_tray_has_children(index)) {
+        g_variant_builder_add(props, "{sv}", "children-display", g_variant_new_string("submenu"));
+    }
+}
