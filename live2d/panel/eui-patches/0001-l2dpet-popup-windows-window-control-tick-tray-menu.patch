+
+static eui_tray_entry* g_items = NULL;
+static int g_item_count = 0;
+static int g_clicks[64];
+static int g_click_head = 0;
+static int g_click_tail = 0;
+
+static void eui_tray_push_click(int id) {
+    const int next = (g_click_tail + 1) % 64;
+    if (next != g_click_head) {
+        g_clicks[g_click_tail] = id;
+        g_click_tail = next;
+    }
+}
+
+static int eui_tray_has_children(int index) {
+    for (int i = 0; i < g_item_count; ++i) {
+        if (g_items[i].parent == index) return 1;
+    }
+    return 0;
+}
+
+static void eui_tray_backend_menu_changed(void);   /* 各后端实现（无后端 = 空） */
+
+static char g_tray_title[128] = "EUI NEO";
+
+void eui_tray_set_title(const char* title) {
+    if (title != NULL && title[0] != '\0') {
+        strncpy(g_tray_title, title, sizeof(g_tray_title) - 1);
+        g_tray_title[sizeof(g_tray_title) - 1] = '\0';
+    }
+}
+
+void eui_tray_set_menu(const eui_tray_item* items, int count) {
+    for (int i = 0; i < g_item_count; ++i) free(g_items[i].label);
+    free(g_items);
+    g_items = NULL;
+    g_item_count = 0;
+    if (items != NULL && count > 0) {
+        g_items = (eui_tray_entry*)calloc((size_t)count, sizeof(eui_tray_entry));
+        if (g_items != NULL) {
+            for (int i = 0; i < count; ++i) {
+                const char* label = items[i].label != NULL ? items[i].label : "";
+                g_items[i].id = items[i].id;
+                g_items[i].label = (char*)malloc(strlen(label) + 1);
+                if (g_items[i].label != NULL) memcpy(g_items[i].label, label, strlen(label) + 1);
+                g_items[i].checked = items[i].checked;
+                g_items[i].enabled = items[i].enabled;
+                g_items[i].separator = items[i].separator;
+                g_items[i].radio = items[i].radio;
+                g_items[i].parent = items[i].parent;
+                g_items[i].checkable = items[i].checkable;
+            }
+            g_item_count = count;
+        }
+    }
+    eui_tray_backend_menu_changed();
+}
+
+int eui_tray_consume_menu_click(void) {
+    if (g_click_head == g_click_tail) return -1;
+    const int id = g_clicks[g_click_head];
+    g_click_head = (g_click_head + 1) % 64;
+    return id;
+}
