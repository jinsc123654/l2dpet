+void setTrayMenu(const std::vector<TrayMenuItem>& items) {
+    std::vector<eui_tray_item> flat;
+    std::vector<std::string> labels;   // 保活到 eui_tray_set_menu 拷贝完
+    std::function<void(const std::vector<TrayMenuItem>&, int)> walk = [&](const std::vector<TrayMenuItem>& level, int parent) {
+        for (const TrayMenuItem& it : level) {
+            eui_tray_item c{};
+            c.id = it.id;
+            c.checked = it.checked ? 1 : 0;
+            c.enabled = it.enabled ? 1 : 0;
+            c.separator = it.separator ? 1 : 0;
+            c.radio = it.radio ? 1 : 0;
+            c.checkable = it.checkable ? 1 : 0;
+            c.parent = parent;
+            labels.push_back(it.label);
+            flat.push_back(c);
+            const int self = static_cast<int>(flat.size()) - 1;
+            if (!it.children.empty()) walk(it.children, self);
+        }
+    };
+    labels.reserve(256);
+    walk(items, -1);
+    for (size_t i = 0; i < flat.size(); ++i) flat[i].label = labels[i].c_str();
+    eui_tray_set_menu(flat.empty() ? nullptr : flat.data(), static_cast<int>(flat.size()));
+}
+
+bool consumeTrayMenuClick(int* id) {
+    const int v = eui_tray_consume_menu_click();
+    if (v < 0) return false;
+    if (id != nullptr) *id = v;
+    return true;
+}
