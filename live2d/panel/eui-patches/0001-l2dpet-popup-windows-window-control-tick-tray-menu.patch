+static GVariant* eui_dm_entry_tuple(int index, gint32 depth) {
+    GVariantBuilder tuple;
+    g_variant_builder_init(&tuple, G_VARIANT_TYPE("(ia{sv}av)"));
+    g_variant_builder_add_value(&tuple, g_variant_new_int32(index + 1));
+    GVariantBuilder props;
+    g_variant_builder_init(&props, G_VARIANT_TYPE("a{sv}"));
+    eui_dm_entry_props(&props, index);
+    g_variant_builder_add_value(&tuple, g_variant_builder_end(&props));
+    GVariantBuilder children;
+    g_variant_builder_init(&children, G_VARIANT_TYPE("av"));
+    if (depth != 0) {
+        for (int i = 0; i < g_item_count; ++i) {
+            if (g_items[i].parent == index) {
+                g_variant_builder_add_value(&children, g_variant_new_variant(eui_dm_entry_tuple(i, depth - 1)));
+            }
+        }
+    }
+    g_variant_builder_add_value(&tuple, g_variant_builder_end(&children));
+    return g_variant_builder_end(&tuple);
+}
+
